# chip-backend environment

# Port the API listens on (default 3001)
PORT=3001

# --- AirGradient Public API (national school climate network) ---
# The UNICEF Lao PDR network is public and needs NO token, so the live connector
# is ON by default. It filters to publicContributorName = "UNICEF".
#
# AIRGRADIENT_ENABLED=false          # force the synthetic fallback instead
# AIRGRADIENT_CONTRIBUTOR=UNICEF     # public contributor to ingest
# AIRGRADIENT_BASE_URL=https://api.airgradient.com
# AIRGRADIENT_TIMEOUT_MS=10000
# AIRGRADIENT_API_TOKEN=             # optional; passed through if your access needs one
